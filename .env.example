# KanjiLens configuration. Copy to `.env` (docker compose) or `.env.local` (npm run dev).
# Never commit the real file.

# ---- Database ---------------------------------------------------------------
# docker compose: only POSTGRES_PASSWORD is needed; DATABASE_URL is built for you.
# Use a long random value without @ : / ? # (or percent-encode them).
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# npm run dev / any non-compose setup: full connection string (required).
DATABASE_URL=postgres://kanjilens:change-me@127.0.0.1:5432/kanjilens

# Optional: max connections in the app's pool (default 10).
# DATABASE_POOL_MAX=10

# ---- Storage ----------------------------------------------------------------
# Where uploaded scan photos are stored. Default ./data/uploads (Docker: /app/data/uploads).
# UPLOAD_DIR=./data/uploads

# ---- Auth -------------------------------------------------------------------
# Secure flag on the session cookie: auto | true | false.
# auto (default) sets it when the request arrived over HTTPS, including through a
# reverse proxy / Cloudflare Tunnel that sends X-Forwarded-Proto.
# COOKIE_SECURE=auto

# Allow new accounts to sign up. The very first account can always be created
# (so the owner can bootstrap); after that sign-up is closed unless this is true.
ALLOW_SIGNUP=false

# Host port for docker compose (default 3000).
# APP_PORT=3000

# ---- Optional AI / OCR ------------------------------------------------------
# OpenAI: fills in readings, meanings and example sentences for new words and
# translates scanned text. Without it, you type readings/meanings yourself.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-nano-2025-08-07

# Google Cloud Vision service-account key as a single-line JSON string.
# Without it, scanning uses mock OCR data (for development only).
GOOGLE_VISION_CREDENTIALS_JSON=
